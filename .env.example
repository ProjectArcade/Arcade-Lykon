# Lykon Telemetry Configuration Template
# Copy this file to '.env' in the repository root directory to configure telemetry locally.
# Do NOT commit your actual '.env' file containing the real keys to the repository.

# The Axiom API Key / Token used for crash telemetry ingestion.
# Obtain this token from your Axiom dashboard.
AXIOM_TOKEN="your_axiom_api_key_here"

# Alternatively, you can use the AXIOM_API_KEY environment variable.
# AXIOM_API_KEY="your_axiom_api_key_here"
