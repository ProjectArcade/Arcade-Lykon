EXPORTS += [
   "AdblockEngine.h",
   "libadblock.h",
]

EXTRA_JS_MODULES += [
   "AdblockConfig.sys.mjs",
   "AdblockIntegration.sys.mjs",
   "AdblockService.sys.mjs",
   "easylist.txt",
   "easyprivacy.txt",
   "FilterManager.sys.mjs",
   "ShieldIntegration.sys.mjs",
   "ShieldToggle.sys.mjs",
   "ShieldUIController.sys.mjs",
   "StatsMonitor.sys.mjs",
]

EXTRA_COMPONENTS += [
   "adblock.manifest",
   "components.conf",
]

SOURCES += [
   "AdblockEngine.cpp",
]

UNIFIED_SOURCES += []

LOCAL_INCLUDES += [
   ".",
]

OS_LIBS += [
   "-L%s/browser/components/adblock" % TOPSRCDIR,
   "-l:libadblock.so",
]

LDFLAGS += [
   "-Wl,-rpath,$ORIGIN",
]

CXXFLAGS += ["-fvisibility=default"]

FINAL_LIBRARY = "xul"

FINAL_TARGET_FILES.bin[""] += [
   "libadblock.so",
]
